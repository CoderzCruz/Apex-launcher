<?xml version="1.0" encoding="utf-8"?>
<!--
    Boot splash: the Apex launch artwork with a working progress bar. Drawn by
    net.kdt.pojavlaunch.aerix.ui.ApexBootSplashView, which replaces the bar painted into the image.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aerix_canvas">

    <net.kdt.pojavlaunch.aerix.ui.ApexBootSplashView
        android:id="@+id/apex_boot_splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
